# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit real keys here.

# Base URL of the Laravel backend's public API (see project.txt API DEPENDENCY NOTE)
API_BASE_URL=http://localhost/pickup_drop/public/api

# Google Maps API key (Places Autocomplete, Directions, Distance Matrix) — Module 4
GOOGLE_MAPS_API_KEY=

# local | production — controls debug logging and other environment-specific behavior
APP_ENV=local
