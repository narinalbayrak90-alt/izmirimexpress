# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit real keys here.

# Base URL of the Laravel backend's public API, same backend the User App
# talks to — this app just uses its /api/rider/* routes.
API_BASE_URL=https://izmirimexpress.com/admin/api

# Google Maps API key (live map, geocoding) — shared with the User App's key.
GOOGLE_MAPS_API_KEY=

# local | production — controls debug logging and other environment-specific behavior
APP_ENV=local
